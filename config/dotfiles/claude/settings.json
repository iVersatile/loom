{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "permissions": {
    "allow": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge --auto:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)"
    ],
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(sudo:*)",
      "Bash(doas:*)",
      "Bash(git push --force)",
      "Bash(git push --force :*)",
      "Bash(git push -f)",
      "Bash(git push -f :*)",
      "Bash(git commit --no-verify:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(socat:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(telnet:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(node -e:*)",
      "Bash(node --eval:*)",
      "Bash(perl -e:*)",
      "Bash(perl -E:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/guard-bash"
          },
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/role-push-guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/checkpoint-inject"
          }
        ]
      }
    ]
  }
}
