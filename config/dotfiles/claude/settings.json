{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "permissions": {
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(sudo:*)",
      "Bash(git push --force)",
      "Bash(git push --force :*)",
      "Bash(git push -f)",
      "Bash(git push -f :*)",
      "Bash(git commit --no-verify:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/guard-bash"
          }
        ]
      }
    ]
  }
}
