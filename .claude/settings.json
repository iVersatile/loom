{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(gofmt:*)",
      "Bash(make gate)",
      "Bash(make gate-integration)",
      "Bash(make test)",
      "Bash(make fr-verify)",
      "Bash(make cover)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(//root/.claude/.credentials.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "WebFetch",
      "WebSearch",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sudo:*)",
      "Bash(git push --force)",
      "Bash(git push --force :*)",
      "Bash(git push -f)",
      "Bash(git push -f :*)",
      "Bash(git commit --no-verify:*)",
      "Bash(loom teardown:*)",
      "Bash(loom build --force:*)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)",
      "Edit(//root/.claude/settings.json)",
      "Write(//root/.claude/settings.json)",
      "Edit(//root/.claude/hooks/**)",
      "Write(//root/.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/allow-compound.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/drain-inbox.sh"
          }
        ]
      }
    ]
  }
}